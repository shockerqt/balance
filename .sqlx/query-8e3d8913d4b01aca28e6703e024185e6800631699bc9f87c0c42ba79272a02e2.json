{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                mf.id,\n                mf.meal_id,\n                mf.food_version_id,\n                fv.name as food_name,\n                mf.serving_name,\n                mf.serving_quantity,\n                fv.calories,\n                fv.proteins,\n                fv.carbs,\n                fv.fat,\n                fv.fiber,\n                fv.sodium,\n                fv.cholesterol,\n                fv.serving_quantity as base_quantity\n            FROM meal_foods mf\n            JOIN food_versions fv ON mf.food_version_id = fv.id\n            WHERE mf.meal_id = $1\n            ORDER BY mf.id ASC\n            ",
