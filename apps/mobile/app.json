{
  "expo": {
    "name": "Balance",
    "slug": "balance",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/balance-icon.png",
    "scheme": "balance",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.balance.app",
      "versionCode": 2,
      "newArchEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#010517",
        "foregroundImage": "./assets/images/balance-icon-foreground.png",
        "monochromeImage": "./assets/images/balance-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/lucide",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d4fb81c-b61b-4764-ab7f-eb13c28b00c1"
      }
    },
    "owner": "shocker",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8d4fb81c-b61b-4764-ab7f-eb13c28b00c1"
    }
  }
}
