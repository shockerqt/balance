{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "daily",
      "env": {
        "APP_VARIANT": "daily"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
